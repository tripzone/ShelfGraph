# Firebase web app config — Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Books API key — Google Cloud Console, restricted by HTTP referrer to your domain(s)
VITE_GOOGLE_BOOKS_API_KEY=

# Set to "true" to point the client SDKs at `firebase emulators:start` instead of production
VITE_USE_FIREBASE_EMULATORS=false
